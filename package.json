{
  "name": "jonggrang",
  "version": "0.5.2",
  "description": "Deterministic AI orchestration platform — 16-phase workflow engine for autonomous software development",
  "license": "MIT",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "claude",
    "opencode",
    "workflow",
    "autonomous",
    "developer-tools"
  ],
  "bin": {
    "jonggrang": "./bin/jonggrang.js"
  },
  "files": [
    "bin",
    "lib",
    "client/dist",
    "server.js",
    "templates",
    "skills",
    "hooks",
    "docs",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "start": "bash scripts/ensure-build.sh && node server.js",
    "dev:server": "node server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "npm run dev:server & npm run dev:client",
    "build": "cd client && npm install && npm run build",
    "predev:server": "bash scripts/ensure-build.sh",
    "install:all": "npm install && cd client && npm install",
    "check": "bash scripts/check.sh",
    "check:quick": "bash scripts/check.sh --quick",
    "check:syntax": "bash scripts/check.sh --syntax-only"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@earendil-works/pi-coding-agent": "^0.74.2",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "js-yaml": "^4.1.1",
    "socket.io": "^4.8.1"
  }
}
