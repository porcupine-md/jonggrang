{
  "_comment": "JONGGRANG — Codex hooks config. Generated by jonggrang init. The dispatcher (hooks/codex/dispatcher.js) reads one JSON payload on stdin and emits codex's per-event output contract. See docs/AGENTTOOLS.md for the full mapping. Project-local hooks require trust via /hooks unless --dangerously-bypass-hook-trust is passed.",
  "_codex_events": {
    "PreToolUse": "deny via hookSpecificOutput.permissionDecision:'deny' — intercepts Bash, apply_patch (Edit/Write alias), MCP tools. CAVEAT: does not intercept every shell path (unified_exec) or WebSearch/non-MCP tools.",
    "PostToolUse": "decision:'block' does NOT undo the command — replaces tool result with feedback. additionalContext adds model-visible warning.",
    "Stop": "decision:'block' = CONTINUE (not reject). Codex uses reason as a new continuation prompt.",
    "SubagentStop": "same continue semantics as Stop, for subagent scope.",
    "SessionStart": "additionalContext injects developer context. matcher on source: startup|resume|clear|compact.",
    "SubagentStart": "additionalContext for the subagent. matcher on agent_type."
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/codex/dispatcher.js\" sessionInit",
            "timeout": 30,
            "statusMessage": "jonggrang: session role init"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/codex/dispatcher.js\" blockSecretCommands",
            "timeout": 30,
            "statusMessage": "jonggrang: block secret-dump commands"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/codex/dispatcher.js\" blockSensitiveFiles",
            "timeout": 30,
            "statusMessage": "jonggrang: block sensitive files"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/codex/dispatcher.js\" agentFirst",
            "timeout": 30,
            "statusMessage": "jonggrang: agent-first enforcement"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/codex/dispatcher.js\" trackModifications",
            "timeout": 30,
            "statusMessage": "jonggrang: track modifications"
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/codex/dispatcher.js\" sanitizeOutput",
            "timeout": 30,
            "statusMessage": "jonggrang: sanitize output"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/codex/dispatcher.js\" taskRoleClaim",
            "timeout": 30,
            "statusMessage": "jonggrang: queue subagent role"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/codex/dispatcher.js\" taskSkillEnforcement",
            "timeout": 30,
            "statusMessage": "jonggrang: skill compliance check"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/codex/dispatcher.js\" outputEnforcement",
            "timeout": 30,
            "statusMessage": "jonggrang: output location enforcement"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/codex/dispatcher.js\" secretFinalCheck",
            "timeout": 120,
            "statusMessage": "jonggrang: final secret scan"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/codex/dispatcher.js\" feedbackLoop",
            "timeout": 60,
            "statusMessage": "jonggrang: feedback loop gate"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/hooks/codex/dispatcher.js\" qualityGate",
            "timeout": 30,
            "statusMessage": "jonggrang: quality gate"
          }
        ]
      }
    ]
  }
}
